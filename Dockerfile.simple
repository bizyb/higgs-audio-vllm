# Simplified Dockerfile for Higgs Audio vLLM
# Uses official vLLM image as base, adds higgs-audio on top

FROM vllm/vllm-openai:v0.8.3

# vLLM is installed at this path in the base image
ENV VLLM_PATH=/usr/local/lib/python3.12/dist-packages/vllm

# Install higgs-audio dependencies
COPY requirements/bosonai.txt /tmp/bosonai.txt
RUN pip install --no-cache-dir -r /tmp/bosonai.txt

# Install higgs-audio from GitHub (the boson_multimodal package)
RUN pip install --no-cache-dir git+https://github.com/boson-ai/higgs-audio.git

# Create bosonai entrypoints directory
RUN mkdir -p $VLLM_PATH/entrypoints/bosonai

# Copy bosonai entrypoints
COPY vllm/entrypoints/bosonai/ $VLLM_PATH/entrypoints/bosonai/

# Copy higgs audio model files
COPY vllm/model_executor/models/higgs_audio.py $VLLM_PATH/model_executor/models/
COPY vllm/model_executor/models/higgs_audio_config.py $VLLM_PATH/model_executor/models/
COPY vllm/model_executor/models/higgs_audio_tokenizer.py $VLLM_PATH/model_executor/models/

# Set entrypoint for audio server
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.bosonai.api_server"]
