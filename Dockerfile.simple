# Simplified Dockerfile for Higgs Audio vLLM
# Uses official vLLM image as base, adds higgs-audio on top

FROM vllm/vllm-openai:v0.8.3

# Debug: show what's in this image
RUN echo "=== Python location ===" && \
    which python3 && \
    python3 --version && \
    echo "=== Looking for vllm ===" && \
    python3 -c "import vllm; print('vllm path:', vllm.__path__[0])" || echo "vllm import failed" && \
    echo "=== Pip list vllm ===" && \
    pip show vllm || echo "pip show failed" && \
    echo "=== Find vllm directories ===" && \
    find /usr -name "vllm" -type d 2>/dev/null | head -10 || true && \
    echo "=== Site packages ===" && \
    python3 -c "import site; print(site.getsitepackages())" || true

# Install higgs-audio dependencies
COPY requirements/bosonai.txt /tmp/bosonai.txt
RUN pip install --no-cache-dir -r /tmp/bosonai.txt

# Install higgs-audio from GitHub (the boson_multimodal package)
RUN pip install --no-cache-dir git+https://github.com/boson-ai/higgs-audio.git

# Now find and setup vLLM path
RUN VLLM_PATH=$(python3 -c "import vllm; print(vllm.__path__[0])") && \
    echo "Using VLLM_PATH: $VLLM_PATH" && \
    mkdir -p $VLLM_PATH/entrypoints/bosonai && \
    ln -sf $VLLM_PATH /vllm_pkg

# Copy bosonai entrypoints
COPY vllm/entrypoints/bosonai/ /vllm_pkg/entrypoints/bosonai/

# Copy higgs audio model files
COPY vllm/model_executor/models/higgs_audio.py /vllm_pkg/model_executor/models/
COPY vllm/model_executor/models/higgs_audio_config.py /vllm_pkg/model_executor/models/
COPY vllm/model_executor/models/higgs_audio_tokenizer.py /vllm_pkg/model_executor/models/

# Set entrypoint for audio server
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.bosonai.api_server"]
